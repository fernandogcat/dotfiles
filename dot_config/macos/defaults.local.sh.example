# Machine-local macOS defaults. Copy to defaults.local.sh (untracked) and edit.
#
#   cp ~/.config/macos/defaults.local.sh.example ~/.config/macos/defaults.local.sh
#
# Sourced at the end of the system settings setup script. That script only runs
# once per content change, so after editing this file apply it by hand:
#
#   bash ~/.config/macos/defaults.local.sh
#
# Put here anything that names this machine: volumes, hostnames, local paths,
# and login items for apps tied to your accounts.

# Screenshots folder
# defaults write com.apple.screencapture location "$HOME/Pictures/Screenshots"

# Extra login items (addLoginItem is defined by the setup script; guard for manual runs)
# if type addLoginItem >/dev/null 2>&1; then
#   addLoginItem "Some App"
# fi
