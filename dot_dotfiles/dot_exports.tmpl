# .exports

# Language
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# XDG
export XDG_CONFIG_HOME="$HOME/.config"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/config"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"

# Starship
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"

# Zoxide: silence the chpwd_functions doctor warning that misfires in
# non-interactive subshells, where chpwd_functions isn't populated even
# though `zoxide init zsh` ran.
export _ZO_DOCTOR=0

# Eza
export EZA_COLORS='di=1;34'

# Pyenv
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"

# Machine-local exports (untracked), e.g. tools installed on external volumes.
# Loaded here so the sections below can pick up its overrides.
[[ -f ~/.config/shell/exports.local.zsh ]] && source ~/.config/shell/exports.local.zsh

{{ if eq .role "personal" -}}
# Java & Android
export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
export PATH="$JAVA_HOME/bin:$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools:$PATH"

# Dotnet (installed manually, not via chezmoi, for use with https://github.com/chickensoft-games/GodotEnv)
export PATH="$PATH:$HOME/.dotnet/tools"

# Godot (godotenv is installed by hand, see the Dotnet section, so skip until it exists)
if command -v godotenv >/dev/null; then
  export GODOT="$(godotenv godot env path | sed 's/ /\\ /g')"
  export GODOT_VERSIONS="$(dirname "$GODOT")/../versions"
fi

# Homebrew
export PATH="/opt/homebrew/bin:$PATH"

{{ end -}}
# Local binaries
export PATH="$HOME/.local/bin:$PATH"