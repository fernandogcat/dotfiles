{{ if eq .role "remote" -}}
#!/bin/bash
set -eufo pipefail

{{/* Re-run when the untracked web UI credentials change, not only when this script does. */ -}}
{{- $guiEnv := joinPath .chezmoi.homeDir ".config/remote/syncthing-gui.env" -}}
{{- if stat $guiEnv }}
# syncthing-gui.env hash: {{ include $guiEnv | sha256sum }}
{{- end }}

if ! dpkg -s syncthing >/dev/null 2>&1; then
  echo "🔄  Installing Syncthing from apt.syncthing.net (sudo)"
  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL -o /etc/apt/keyrings/syncthing-archive-keyring.gpg https://syncthing.net/release-key.gpg
  echo "deb [signed-by=/etc/apt/keyrings/syncthing-archive-keyring.gpg] https://apt.syncthing.net/ syncthing stable-v2" \
    | sudo tee /etc/apt/sources.list.d/syncthing.list >/dev/null
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq syncthing
fi

# System-level per-user unit: starts at boot without a login. Devices and folders are set in the web UI (localhost:8384).
if [ -d /run/systemd/system ]; then
  # The packaged unit only waits for network.target: start once the network is up, so DNS works for relays and discovery.
  dropIn=/etc/systemd/system/syncthing@.service.d/10-network-online.conf
  want=$'[Unit]\nWants=network-online.target\nAfter=network-online.target'
  if [ "$(cat "$dropIn" 2>/dev/null)" != "$want" ]; then
    sudo install -d -m 0755 "$(dirname "$dropIn")"
    printf '%s\n' "$want" | sudo tee "$dropIn" >/dev/null
    sudo systemctl daemon-reload
    echo "✅  syncthing@ waits for network-online.target"
  fi

  sudo systemctl enable --now "syncthing@$(id -un)" >/dev/null
  echo "✅  syncthing@$(id -un) enabled"

  # Optional web UI login from an untracked file: ST_GUI_USER and ST_GUI_PASSWORD_HASH (bcrypt, never the plain password).
  guiEnv="$HOME/.config/remote/syncthing-gui.env"
  if [ -f "$guiEnv" ]; then
    # shellcheck disable=SC1090
    . "$guiEnv"
    for _ in $(seq 30); do syncthing cli show system >/dev/null 2>&1 && break; sleep 1; done
    if [ "$(syncthing cli config gui user get)" != "$ST_GUI_USER" ] \
      || [ "$(syncthing cli config gui password get)" != "$ST_GUI_PASSWORD_HASH" ]; then
      syncthing cli config gui user set "$ST_GUI_USER"
      syncthing cli config gui password set "$ST_GUI_PASSWORD_HASH"
      echo "🔑  Syncthing web UI login set for $ST_GUI_USER"
    fi
  fi
fi
{{ end -}}
