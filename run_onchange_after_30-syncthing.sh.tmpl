{{ if eq .role "remote" -}}
#!/bin/bash
set -eufo pipefail

if ! dpkg -s syncthing >/dev/null 2>&1; then
  echo "🔄  Installing Syncthing from apt.syncthing.net (sudo)"
  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL -o /etc/apt/keyrings/syncthing-archive-keyring.gpg https://syncthing.net/release-key.gpg
  echo "deb [signed-by=/etc/apt/keyrings/syncthing-archive-keyring.gpg] https://apt.syncthing.net/ syncthing stable-v2" \
    | sudo tee /etc/apt/sources.list.d/syncthing.list >/dev/null
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq syncthing
fi

# System-level per-user unit: starts at boot without a login. Devices and folders are set in the web UI (localhost:8384).
if [ -d /run/systemd/system ]; then
  sudo systemctl enable --now "syncthing@$(id -un)" >/dev/null
  echo "✅  syncthing@$(id -un) enabled"
fi
{{ end -}}
