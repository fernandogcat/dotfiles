{
  "data": {
    "email": {{ promptStringOnce . "email" "What is your email" | quote }},
    "setSshKey": {{ promptBoolOnce . "setSshKey" "Do you want to set up an SSH key" }},
    "gitSigningKeyName": "id_github",
    "role": {{ promptChoiceOnce . "role" "Machine role (personal or remote)" (list "personal" "remote") (eq .chezmoi.os "darwin" | ternary "personal" "remote") | quote }}
  }
}
