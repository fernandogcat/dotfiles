{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -eufo pipefail

{{/* Re-run when the machine-local bundle changes too, not only this script. */ -}}
{{- $localBrewfile := joinPath .chezmoi.homeDir ".config/brew/Brewfile.local" -}}
{{- if stat $localBrewfile }}
# Brewfile.local hash: {{ include $localBrewfile | sha256sum }}
{{- end }}

brew bundle --file=/dev/stdin <<EOF
brew "starship"
brew "git"
brew "tree"
# tried installing wireguard but these are command line tools, check wireguard in the appstore
# brew "wireguard-go"
brew "git-lfs"
brew "bat"
brew "git-delta"
brew "eza"
brew "age"
brew "tlrc"
brew "zoxide"
brew "fzf"
brew "mise"
cask "jordanbaird-ice"
cask "obsidian"
cask "syncthing-app"
cask "firefox"
cask "brave-browser"
cask "libreoffice"
cask "cleanshot"
cask "vlc"
cask "iina"
cask "the-unarchiver"
cask "notion"
cask "ghostty"
cask "rectangle"
cask "raycast"
cask "monitorcontrol"
cask "caffeine"
cask "fork"
cask "vscodium"
cask "cursor"
cask "font-meslo-lg-nerd-font"
EOF

# Machine-local apps (untracked), e.g. services and accounts tied to this machine
if [ -f "$HOME/.config/brew/Brewfile.local" ]; then
  echo "🍺  Installing machine-local bundle"
  brew bundle --file="$HOME/.config/brew/Brewfile.local"
fi
{{ end -}}
