# .zshrc config file
ENABLE_CORRECTION="false"
HIST_STAMPS="dd.mm.yyyy"
plugins=(zsh-autosuggestions)

# Oh-My-Zsh (installed and pinned by chezmoi, so omz must not update itself)
zstyle ':omz:update' mode disabled
export ZSH=$HOME/.oh-my-zsh
source $ZSH/oh-my-zsh.sh

# PNPM
export PNPM_HOME="{{ if eq .chezmoi.os "darwin" }}$HOME/Library/pnpm{{ else }}$HOME/.local/share/pnpm{{ end }}"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Loading dotfiles
for file in ~/.dotfiles/.{exports,aliases,functions,extra}; do
  [ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

# Starship
eval "$(starship init zsh)"

# Zoxide
eval "$(zoxide init zsh)"

# Machine-local aliases/functions (untracked)
[[ -f ~/.config/shell/aliases.local.zsh ]] && source ~/.config/shell/aliases.local.zsh
